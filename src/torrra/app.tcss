/* ------------------------- */
/* GLOBAL STYLES/UTILITIES   */
/* ------------------------- */
.hidden {
  display: none;
}

Input {
  padding: 0 1;
  margin: 0;
  background: transparent;
  border: solid $secondary-muted;
  &:focus {
    border: solid $secondary;
  }
}

DataTable {
  background: transparent;
  border: solid $secondary-muted;
  scrollbar-size: 0 0;
  height: 1fr;
  &:focus {
    border: solid $secondary;
  }
  &:disabled {
    border: solid $secondary-muted;
  }
  & > .datatable--header,
  & > .datatable--header-hover {
    background: transparent;
  }
  & > .datatable--hover {
    background: $primary-muted;
  }
}

DetailsPanel {
  padding: 0 1;
  border: solid $secondary-muted;
  border-title-color: $foreground-muted;
  border-title-style: bold;
  height: auto;
  &:focus {
    border: solid $secondary;
  }
  #details_progress_row {
    height: auto;
    width: 100%;
    align-vertical: middle;
  }
  ProgressBar {
    width: 1fr;
    #bar {
      width: 1fr;
    }
  }
  #details_eta {
    width: auto;
    margin-left: 1;
  }
  #details_shortcuts {
    height: auto;
    color: $foreground-muted;
  }
}

Toast {
  width: auto;
  padding: 0 1;
  background: $surface;
}

StatusBar {
  dock: bottom;
  height: 1;
  width: 100%;
  padding: 0 1;
  background: $surface;
  color: $foreground-muted;
  #shortcuts {
    width: auto;
  }
  #stats {
    width: 1fr;
    text-align: right;
  }
}

/* ------------------------- */
/* WELCOME SCREEN            */
/* ------------------------- */
WelcomeScreen {
  align: center middle;
  #welcome_container {
    max-width: 50;
    height: auto;
    #banner {
      text-align: center;
    }
    #subtitle {
      color: $text-secondary;
      text-align: center;
    }
    #version {
      color: $foreground-muted;
      text-align: center;
    }
    #commands_container {
      margin-top: 1;
      align-horizontal: center;
      height: auto;
      Grid {
        width: 75%;
        height: 4;
        grid-size: 2;
        grid-columns: 1fr auto;
        Static {
          text-align: left;
          color: $foreground-muted;
          &#title {
            text-align: center;
            column-span: 2;
            color: $text-secondary;
          }
          &.key {
            text-align: right;
            color: $text-secondary;
          }
        }
      }
    }
  }
}

/* ------------------------- */
/* HOME SCREEN               */
/* ------------------------- */
HomeScreen #main_layout {
  #sidebar {
    dock: left;
    width: auto;
    min-width: 20;
    border: solid $secondary-muted;
    background: transparent;
    &:focus {
      border: solid $secondary;
    }
  }
  #search_content {
    #search {
      dock: top;
    }
    #loader {
      align: center middle;
      Static {
        content-align-horizontal: center;
      }
      Spinner {
        height: auto;
        content-align-horizontal: center;
        color: $secondary;
      }
    }
  }
}

/* ------------------------- */
/* HELP SCREEN               */
/* ------------------------- */
HelpScreen {
  align: center middle;
  #help-container {
    height: auto;
    max-width: 45;
    max-height: 80%;
    padding-left: 2;
    background: $surface;
    border: tall $secondary;
    Label {
      width: 100%;
      text-align: center;
    }
    .help-subtitle {
      color: $text-muted;
    }
    #help-content {
      margin-top: 1;
      height: 1fr;
      scrollbar-size: 0 0;
      .help-group {
        height: auto;
        margin-bottom: 1;
        &:last-child {
          margin-bottom: 0;
        }
      }
      .help-row {
        color: $text-muted;
      }
    }
    #help-remaining {
      color: $text-muted;
    }
  }
}

ThemeSelectorScreen {
  align: center middle;
  #theme-switcher-container {
    height: auto;
    max-width: 30;
    max-height: 80%;
    Label {
      width: 100%;
      text-align: center;
    }
    ListView {
      margin-top: 1;
      height: 14;
      background: $surface;
      border: tall $secondary;
      Static {
        padding-left: 1;
      }
    }
  }
}

SpeedLimitScreen {
  align: center middle;
  #speed-limit-container {
    height: auto;
    max-width: 44;
    width: 44;
    padding: 0 2;
    background: $surface;
    border: tall $secondary;
    Label {
      width: 100%;
      text-align: left;
    }
    #speed-limit-name {
      color: $text-muted;
      margin-bottom: 1;
    }
    #speed-limit-fields {
      height: auto;
      .speed-field-row {
        height: 1;
        align-vertical: middle;
        .speed-field-label {
          width: 10;
          color: $text;
        }
        Input {
          width: 1fr;
          height: 1;
          border: none;
          background: $surface;
          padding: 0 1;
        }
        .speed-unit-label {
          width: 6;
          color: $text-muted;
          text-align: right;
        }
      }
    }
    .error-text {
      color: $error;
    }
    #speed-limit-footer {
      color: $text-muted;
      text-align: center;
      margin-top: 1;
    }
  }
}

TorrentOptionsScreen {
  align: center middle;
  #torrent-options-container {
    height: auto;
    max-width: 52;
    width: 52;
    padding: 0 2;
    background: $surface;
    border: tall $secondary;
    Label {
      width: 100%;
      text-align: left;
    }
    #torrent-options-name {
      color: $text-muted;
      margin-bottom: 1;
    }
    #torrent-options-fields {
      height: auto;
      .torrent-option-row {
        height: 1;
        align-vertical: middle;
        margin-bottom: 0;
        .torrent-option-label {
          width: 12;
          color: $text;
        }
        Input {
          width: 1fr;
          height: 1;
          border: none;
          background: $surface;
          padding: 0 1;
        }
        .torrent-option-unit-label {
          width: 10;
          color: $text-muted;
          text-align: right;
          margin-left: 1;
        }
      }
      .torrent-option-hint {
        width: 100%;
        color: $text-muted;
        margin-bottom: 1;
      }
      .checkbox-row {
        height: 1;
        margin-top: 1;
        align-vertical: middle;
        Checkbox {
          background: $surface;
          border: none;
          height: 1;
          padding: 0;
        }
      }
    }
    .error-text {
      color: $error;
    }
    #torrent-options-footer {
      color: $text-muted;
      text-align: center;
      margin-top: 1;
    }
  }
}

/* ------------------------- */
/* SORT SELECT SCREEN        */
/* ------------------------- */
SortSelectorScreen {
  align: center middle;
  #sort-selector-container {
    height: auto;
    max-width: 30;
    max-height: 80%;
    Label {
      width: 100%;
      text-align: center;
    }
    ListView {
      margin-top: 1;
      height: auto;
      background: $surface;
      border: tall $secondary;
      Static {
        padding-left: 1;
      }
    }
  }
}

/* ------------------------- */
/* FILE SELECTION SCREEN     */
/* ------------------------- */
FileSelectionScreen {
  align: center middle;
  #file-selection-container {
    height: auto;
    max-height: 80%;
    width: 60;
    max-width: 85%;
    background: $surface;
    border: tall $secondary;
    padding: 0 1;
    &.loaded {
      height: 21;
    }
    #file-selection-header {
      height: auto;
      margin-bottom: 1;
      #torrent-name {
        padding: 0 1;
        width: 100%;
        text-align: center;
        color: $foreground;
        text-style: bold;
      }
      #selection-stats {
        width: 100%;
        text-align: center;
        color: $foreground-muted;
      }
      #save-path-label {
        margin-top: 1;
        color: $foreground-muted;
      }
      #save-path {
        height: 1;
        border: none;
        background: $surface;
      }
    }
    #file-selection-loading {
      height: auto;
      #loading-spinner-area {
        height: auto;
        align: center middle;
        margin-bottom: 1;
        Static {
          text-align: center;
          content-align-horizontal: center;
        }
        Spinner {
          height: auto;
          content-align-horizontal: center;
          color: $secondary;
        }
      }
      #loading-cancel-hint {
        height: auto;
        width: 100%;
        text-align: center;
        color: $foreground-muted;
      }
    }
    #file-selection-body {
      height: 1fr;
      margin: 0;
      FileSelectionTree {
        height: 1fr;
        border: none;
        scrollbar-size: 0 0;
      }
    }
    #file-selection-footer {
      height: auto;
      margin-top: 1;
      #shortcuts-hint {
        width: 100%;
        text-align: center;
        color: $foreground-muted;
      }
    }
  }
}
