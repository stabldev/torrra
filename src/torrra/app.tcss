/* ------------------------- */
/* GLOBAL STYLES/UTILITIES   */
/* ------------------------- */
.hidden {
  display: none;
}

Input {
  padding: 0 1;
  margin: 0;
  background: transparent;
  border: solid $secondary-muted;
  &:focus {
    border: solid $secondary;
  }
}

DataTable {
  background: transparent;
  border: solid $secondary-muted;
  scrollbar-size: 0 0;
  height: 1fr;
  &:focus {
    border: solid $secondary;
  }
  &:disabled {
    border: solid $secondary-muted;
  }
  & > .datatable--header,
  & > .datatable--header-hover {
    background: transparent;
  }
  & > .datatable--hover {
    background: $primary-muted;
  }
}

DetailsPanel {
  padding: 0 1;
  border: solid $secondary-muted;
  height: auto;
  &:focus {
    border: solid $secondary;
  }
  ProgressBar {
    #bar {
      width: 1fr;
    }
  }
}

Toast {
  width: auto;
  padding: 0 1;
  background: $surface;
}

/* ------------------------- */
/* WELCOME SCREEN            */
/* ------------------------- */
WelcomeScreen {
  align: center middle;
  #welcome_container {
    max-width: 50;
    height: auto;
    #banner {
      text-align: center;
    }
    #subtitle {
      color: $text-secondary;
      text-align: center;
    }
    #version {
      color: $foreground-muted;
      text-align: center;
    }
    #commands_container {
      margin-top: 1;
      align-horizontal: center;
      height: auto;
      Grid {
        width: 75%;
        height: 4;
        grid-size: 2;
        grid-columns: 1fr auto;
        Static {
          text-align: left;
          color: $foreground-muted;
          &#title {
            text-align: center;
            column-span: 2;
            color: $text-secondary;
          }
          &.key {
            text-align: right;
            color: $text-secondary;
          }
        }
      }
    }
  }
}

/* ------------------------- */
/* HOME SCREEN               */
/* ------------------------- */
HomeScreen #main_layout {
  #sidebar {
    dock: left;
    width: auto;
    min-width: 20;
    padding-right: 1;
    border: solid $secondary-muted;
    background: transparent;
    &:focus {
      border: solid $secondary;
    }
    & > .tree--highlight-line {
      background: $primary-muted;
    }
  }
  #search_content {
    #search {
      dock: top;
    }
    #loader {
      align: center middle;
      Static {
        content-align-horizontal: center;
      }
      Spinner {
        height: auto;
        content-align-horizontal: center;
        color: $secondary;
      }
    }
  }
}

/* ------------------------- */
/* THEME SWITCH SCREEN       */
/* ------------------------- */
ThemeSelectorScreen {
  align: center middle;
  #theme-switcher-container {
    height: auto;
    max-width: 30;
    max-height: 80%;
    Label {
      width: 100%;
      text-align: center;
    }
    ListView {
      margin-top: 1;
      height: 14;
      background: $surface;
      border: tall $secondary;
      Static {
        padding-left: 1;
      }
    }
  }
}

/* ------------------------- */
/* FILE SELECTION SCREEN     */
/* ------------------------- */
FileSelectionScreen {
  align: center middle;
  #file_selection_container {
    width: 80%;
    max-width: 90;
    height: 80%;
    max-height: 80%;
    background: $surface;
    border: tall $secondary;
    padding: 1;
    #file_selection_title {
      text-align: center;
      height: auto;
    }
    #file_selection_loader {
      align: center middle;
      height: 1fr;
      Static {
        content-align-horizontal: center;
      }
      Spinner {
        height: auto;
        content-align-horizontal: center;
        color: $secondary;
      }
    }
    #file_selection_header {
      height: auto;
      padding: 0 1;
      color: $text-secondary;
      text-style: bold;
    }
    #file_selection_tree {
      height: 1fr;
      margin-top: 1;
      border: solid $secondary-muted;
      padding: 0 1;
      & > .tree--highlight-line {
        background: $primary-muted;
      }
      &:focus {
        border: solid $secondary;
      }
    }
    #file_selection_hint {
      height: auto;
      margin-top: 1;
      padding: 0 1;
      color: $foreground-muted;
      text-align: center;
    }
    #file_selection_footer {
      height: auto;
      margin-top: 1;
      Button {
        margin-right: 1;
      }
    }
  }
}

/* ------------------------- */
/* FILE MANAGER SCREEN       */
/* ------------------------- */
FileManagerScreen {
  align: center middle;
  #file_manager_container {
    width: 80%;
    max-width: 90;
    height: 80%;
    max-height: 80%;
    background: $surface;
    border: tall $secondary;
    padding: 1;
    #file_manager_title {
      text-align: center;
      height: auto;
    }
    #file_manager_loader {
      align: center middle;
      height: 1fr;
      Static {
        content-align-horizontal: center;
      }
      Spinner {
        height: auto;
        content-align-horizontal: center;
        color: $secondary;
      }
    }
    #file_manager_header {
      height: auto;
      padding: 0 1;
      color: $text-secondary;
      text-style: bold;
    }
    #file_manager_table {
      height: 1fr;
      margin-top: 1;
      border: solid $secondary-muted;
      & > .datatable--header {
        text-style: bold;
      }
      &:focus {
        border: solid $secondary;
      }
    }
    #file_manager_hint {
      height: auto;
      margin-top: 1;
      padding: 0 1;
      color: $foreground-muted;
      text-align: center;
    }
    #file_manager_footer {
      height: auto;
      margin-top: 1;
      Button {
        margin-right: 1;
      }
    }
  }
}
